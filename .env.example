# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Postgres connection string (Neon, Railway, or local Postgres all work)
DATABASE_URL="postgresql://user:password@host:5432/boardgamereview"

# Clerk (auth) — get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Signing secret for the Clerk webhook (see app/api/webhooks/clerk/route.ts)
CLERK_WEBHOOK_SECRET=""

# BoardGameGeek API has no key requirement, but we set a contact email
# in our request User-Agent as a courtesy per their API guidelines.
BGG_CONTACT_EMAIL="you@example.com"

# Public base URL of the deployed site (no trailing slash). Used to build
# Open Graph tags, the sitemap, and robots.txt. Set to your real domain
# in production; the local default below is fine for development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shown on the /contact page. This is NEXT_PUBLIC (visible in the
# browser) since it's meant to be — it's just an email address people
# are supposed to see and click.
NEXT_PUBLIC_CONTACT_EMAIL="support@example.com"

# Random secret string used to verify scheduled BGG sync requests really
# came from Vercel Cron and not a random visitor hitting the URL.
CRON_SECRET=""
